{
  "permissions": {
    "deny": [
      "Edit(projects/*/raw/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/python\" \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_raw.py\"",
            "timeout": 10,
            "statusMessage": "Checking raw/ footage guard"
          }
        ]
      }
    ]
  }
}
