# Copy to .env and fill in. Never commit .env.

# Required for AI thumbnail backgrounds / image edits (Gemini image models) and
# Gemini-based video analysis. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Only needed if you want video-use to transcribe with ElevenLabs Scribe
# instead of the local mlx-whisper transcriber (tools/transcribe_local.py).
ELEVENLABS_API_KEY=

# Optional. Upgrades video-trend-research from zero-key YouTube public search to
# official YouTube Data API v3 (exact likes/comments/subs; 10,000 free units/day).
YOUTUBE_API_KEY=

# Optional. Enables structured TikTok API metrics inside video-trend-research
# (otherwise the skill uses targeted web search + optional live browser pass).
SCRAPECREATORS_API_KEY=
